---
import SmilePileLogo from './SmilePileLogo.astro';
---

<header class="sticky top-0 z-50 bg-white shadow-sm">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="Main navigation">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <a href="/" class="focus-visible-ring rounded px-2 py-1 no-underline">
        <SmilePileLogo size="lg" />
      </a>

      <!-- Desktop Navigation -->
      <ul class="hidden md:flex space-x-8">
        <li><a href="/#features" class="text-gray-700 hover:text-primary transition-colors focus-visible-ring rounded px-2 py-1 no-underline">Features</a></li>
        <li><a href="/support" class="text-gray-700 hover:text-primary transition-colors focus-visible-ring rounded px-2 py-1 no-underline">FAQ</a></li>
        <li><a href="/support-us" class="text-gray-700 hover:text-primary transition-colors focus-visible-ring rounded px-2 py-1 no-underline">Support Us</a></li>
        <li><a href="/privacy" class="text-gray-700 hover:text-primary transition-colors focus-visible-ring rounded px-2 py-1 no-underline">Privacy</a></li>
        <li><a href="/terms" class="text-gray-700 hover:text-primary transition-colors focus-visible-ring rounded px-2 py-1 no-underline">Terms</a></li>
      </ul>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 rounded focus-visible-ring min-h-[48px] min-w-[48px]"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <ul id="mobile-menu" class="hidden md:hidden pb-4 space-y-2">
      <li><a href="/#features" class="block px-4 py-2 text-gray-700 hover:bg-primary-50 rounded focus-visible-ring min-h-[48px] no-underline">Features</a></li>
      <li><a href="/support" class="block px-4 py-2 text-gray-700 hover:bg-primary-50 rounded focus-visible-ring min-h-[48px] no-underline">FAQ</a></li>
      <li><a href="/support-us" class="block px-4 py-2 text-gray-700 hover:bg-primary-50 rounded focus-visible-ring min-h-[48px] no-underline">Support Us</a></li>
      <li><a href="/privacy" class="block px-4 py-2 text-gray-700 hover:bg-primary-50 rounded focus-visible-ring min-h-[48px] no-underline">Privacy</a></li>
      <li><a href="/terms" class="block px-4 py-2 text-gray-700 hover:bg-primary-50 rounded focus-visible-ring min-h-[48px] no-underline">Terms</a></li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', (!expanded).toString());
    menu?.classList.toggle('hidden');
  });
</script>
